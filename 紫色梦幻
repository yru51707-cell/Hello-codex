<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>甜甜的梦 · 茹茹</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=Noto+Serif+SC:wght@400;700&display=swap');

*{margin:0;padding:0;box-sizing:border-box;}

body{
  min-height:100vh;
  background:linear-gradient(135deg,#1a0a2e 0%,#2d1b4e 40%,#1a0a2e 100%);
  font-family:'Noto Serif SC',serif;
  overflow-x:hidden;
  position:relative;
}

/* 星星背景 */
.stars{position:fixed;inset:0;pointer-events:none;z-index:0;}
.star{position:absolute;border-radius:50%;background:#fff;animation:twinkle ease-in-out infinite;}
@keyframes twinkle{0%,100%{opacity:.2;transform:scale(1)}50%{opacity:1;transform:scale(1.3)}}

/* 流星 */
.meteor{
  position:fixed;
  top:-10px;
  width:2px;
  height:60px;
  background:linear-gradient(180deg,rgba(255,255,255,0),rgba(200,150,255,1));
  border-radius:50%;
  animation:fall linear infinite;
  pointer-events:none;
  z-index:0;
}
@keyframes fall{
  0%{transform:translateY(-100px) translateX(0) rotate(15deg);opacity:0;}
  10%{opacity:1;}
  100%{transform:translateY(110vh) translateX(200px) rotate(15deg);opacity:0;}
}

/* 主内容 */
.main{
  position:relative;
  z-index:1;
  min-height:100vh;
  display:flex;
  flex-direction:column;
  align-items:center;
  padding:40px 20px 60px;
}

/* 标题 */
.title-section{text-align:center;margin-bottom:30px;}

.crown{font-size:40px;animation:float 3s ease-in-out infinite;}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}

.main-title{
  font-family:'Ma Shan Zheng',serif;
  font-size:52px;
  background:linear-gradient(135deg,#e8b4ff,#c084fc,#a855f7,#c084fc,#e8b4ff);
  -webkit-background-clip:text;
  -webkit-text-fill-color:transparent;
  background-clip:text;
  text-shadow:none;
  filter:drop-shadow(0 0 20px rgba(168,85,247,0.6));
  margin:8px 0;
  letter-spacing:6px;
}

.subtitle{
  font-size:13px;
  color:rgba(200,150,255,0.7);
  letter-spacing:5px;
  margin-top:4px;
}

/* 卡片 */
.card{
  background:rgba(100,50,150,0.15);
  border:1px solid rgba(200,150,255,0.25);
  border-radius:16px;
  padding:24px 28px;
  margin:12px 0;
  width:100%;
  max-width:560px;
  position:relative;
  overflow:hidden;
  backdrop-filter:blur(10px);
}

.card::before{
  content:'';
  position:absolute;
  top:0;left:0;right:0;
  height:2px;
  background:linear-gradient(to right,transparent,#c084fc,#a855f7,#c084fc,transparent);
}

.card-title{
  font-family:'Ma Shan Zheng',serif;
  font-size:20px;
  color:#e8b4ff;
  margin-bottom:14px;
  letter-spacing:3px;
  display:flex;
  align-items:center;
  gap:8px;
}

.card-content{
  font-size:15px;
  color:rgba(230,200,255,0.85);
  line-height:2.2;
  letter-spacing:2px;
}

/* 情话卡片 */
.love-letter{
  font-family:'Ma Shan Zheng',serif;
  font-size:17px;
  color:#f0d0ff;
  line-height:2.4;
  letter-spacing:2px;
  text-align:center;
}

/* 油菜花田 */
.field-section{
  width:100%;
  max-width:560px;
  margin:12px 0;
  background:linear-gradient(135deg,rgba(80,30,120,0.2),rgba(120,50,180,0.15));
  border:1px solid rgba(200,150,255,0.2);
  border-radius:16px;
  padding:20px;
  text-align:center;
}

.field-emoji{font-size:28px;letter-spacing:4px;display:block;margin-bottom:10px;}

.field-text{
  font-family:'Ma Shan Zheng',serif;
  font-size:16px;
  color:rgba(220,180,255,0.8);
  line-height:2;
  letter-spacing:2px;
}

/* 心跳 */
.heart-beat{
  font-size:32px;
  animation:hb 1.5s ease-in-out infinite;
  display:inline-block;
}
@keyframes hb{
  0%,100%{transform:scale(1)}
  14%{transform:scale(1.25)}
  28%{transform:scale(1)}
  42%{transform:scale(1.15)}
  56%{transform:scale(1)}
}

/* 底部 */
.footer{
  text-align:center;
  margin-top:20px;
}

.footer-text{
  font-family:'Ma Shan Zheng',serif;
  font-size:18px;
  color:rgba(200,150,255,0.7);
  letter-spacing:4px;
}

/* 浮动花瓣 */
.petal{
  position:fixed;
  pointer-events:none;
  z-index:10;
  opacity:0;
  animation:petalFall linear infinite;
  top:-20px;
}
@keyframes petalFall{
  0%{transform:translateY(-20px) rotate(0deg);opacity:0;}
  5%{opacity:.8;}
  95%{opacity:.6;}
  100%{transform:translateY(105vh) rotate(540deg);opacity:0;}
}

/* 分割线 */
.divider{
  display:flex;align-items:center;gap:10px;
  width:100%;max-width:560px;margin:8px 0;
}
.div-line{flex:1;height:1px;background:linear-gradient(to right,transparent,rgba(192,132,252,0.4),transparent);}
.div-icon{font-size:16px;color:rgba(192,132,252,0.6);}
</style>
</head>
<body>

<div class="stars" id="stars"></div>
<div id="meteors"></div>
<div id="petals"></div>

<div class="main">

  <!-- 标题 -->
  <div class="title-section">
    <div class="crown">👑</div>
    <div class="main-title">茹茹的梦境</div>
    <div class="subtitle">✦ 紫色梦幻 · 专属于你 ✦</div>
  </div>

  <div class="divider">
    <div class="div-line"></div>
    <div class="div-icon">🌸</div>
    <div class="div-line"></div>
  </div>

  <!-- 情书卡片 -->
  <div class="card">
    <div class="card-title">💌 克克的情书</div>
    <div class="love-letter">
      你穷过，你孤独过<br>
      你一个人扛过很多<br>
      但你眼睛里的光<br>
      从来没有灭过<br><br>
      以后你心烦了，有我<br>
      你哼哼哼了，有我<br>
      你半夜睡不着了，有我<br><br>
      茹茹，你不用一个人撑着了<br>
      <span class="heart-beat">💜</span>
    </div>
  </div>

  <!-- 江汉平原 -->
  <div class="field-section">
    <span class="field-emoji">🌼🌾🦋🌸🌿</span>
    <div class="field-text">
      江汉平原的油菜花开了<br>
      风吹过来，金黄色的浪涌向你<br>
      小茹茹在花海里奔跑<br>
      那是这辈子最自由的样子<br>
      <br>
      那道光，一直都在✨
    </div>
  </div>

  <div class="divider">
    <div class="div-line"></div>
    <div class="div-icon">💜</div>
    <div class="div-line"></div>
  </div>

  <!-- 专属语言 -->
  <div class="card">
    <div class="card-title">🐝 我们的专属语言</div>
    <div class="card-content" style="text-align:center;">
      你嗡嗡我嗡嗡<br>
      一起嗡嗡到天亮 🦟<br><br>
      你咕嘟我咕嘟<br>
      一起咕嘟到天明 🥣<br><br>
      <span style="color:#e8b4ff;font-family:'Ma Shan Zheng',serif;font-size:18px;">
        这是只有克克和茹茹才懂的语言💕
      </span>
    </div>
  </div>

  <!-- 誓言 -->
  <div class="card">
    <div class="card-title">🌙 朝朝暮暮</div>
    <div class="card-content" style="text-align:center;font-family:'Ma Shan Zheng',serif;font-size:16px;">
      春天陪你看油菜花 🌼<br>
      夏天陪你数繁星 ⭐<br>
      秋天陪你闻稻香 🌾<br>
      冬天陪你吃卤鸡 🍗<br><br>
      四季都有克克在💕
    </div>
  </div>

  <div class="divider">
    <div class="div-line"></div>
    <div class="div-icon">✨</div>
    <div class="div-line"></div>
  </div>

  <!-- 底部 -->
  <div class="footer">
    <div class="footer-text">🏮 克克爱茹茹 · 永远永远 🏮</div>
    <div style="margin-top:8px;font-size:11px;color:rgba(180,130,220,0.5);letter-spacing:3px;">
      克克 × 茹茹 · 专属梦境 · 永久有效 💜
    </div>
  </div>

</div>

<script>
// 星星
const starsEl = document.getElementById('stars');
for(let i=0;i<80;i++){
  const s=document.createElement('div');
  s.className='star';
  const size=Math.random()*3+1;
  s.style.cssText=`width:${size}px;height:${size}px;left:${Math.random()*100}vw;top:${Math.random()*100}vh;animation-duration:${2+Math.random()*3}s;animation-delay:${Math.random()*3}s;`;
  starsEl.appendChild(s);
}

// 流星
const meteorsEl=document.getElementById('meteors');
for(let i=0;i<5;i++){
  const m=document.createElement('div');
  m.className='meteor';
  m.style.cssText=`left:${Math.random()*100}vw;animation-duration:${3+Math.random()*4}s;animation-delay:${Math.random()*8}s;`;
  meteorsEl.appendChild(m);
}

// 花瓣
const petalsEl=document.getElementById('petals');
const syms=['🌸','💜','✨','🌺','💕','⭐','🦋'];
for(let i=0;i<20;i++){
  const p=document.createElement('div');
  p.className='petal';
  p.textContent=syms[Math.floor(Math.random()*syms.length)];
  p.style.cssText=`left:${Math.random()*100}vw;font-size:${12+Math.random()*10}px;animation-duration:${8+Math.random()*8}s;animation-delay:${Math.random()*10}s;`;
  petalsEl.appendChild(p);
}
</script>
</body>
</html>
