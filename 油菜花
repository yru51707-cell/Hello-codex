<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>春日 · 油菜花田</title>
<style>
* { margin:0; padding:0; box-sizing:border-box; }
html,body {
  width:100%; height:100%;
  overflow:hidden;
  background: linear-gradient(to bottom, #aee0ee 0%, #c9e8e6 28%, #dcebd2 48%, #eddb84 62%, #d8c468 100%);
  font-family: "Songti SC", "STSong", "SimSun", serif;
}
#stage {
  position:relative;
  width:100vw; height:100vh;
}

/* 太阳 */
.sun {
  position:absolute;
  top:8%; left:14%;
  width:90px; height:90px;
  border-radius:50%;
  background: radial-gradient(circle at 40% 35%, #fffaf0, #fce9a8 55%, #f4d77e 100%);
  box-shadow: 0 0 50px 22px rgba(252,233,168,0.35), 0 0 100px 50px rgba(252,233,168,0.12);
}

/* 远山 */
.hills-far {
  position:absolute;
  bottom:48%;
  width:100%;
  height:12%;
  background:#9fb6ad;
  opacity:0.55;
  clip-path: polygon(0% 100%, 0% 55%, 12% 35%, 28% 50%, 42% 22%, 58% 45%, 72% 20%, 86% 42%, 100% 30%, 100% 100%);
}
.hills-near {
  position:absolute;
  bottom:44%;
  width:100%;
  height:10%;
  background:#7e9a82;
  opacity:0.7;
  clip-path: polygon(0% 100%, 0% 65%, 15% 45%, 30% 60%, 48% 35%, 64% 58%, 80% 40%, 100% 55%, 100% 100%);
}

/* 溪流 */
.stream {
  position:absolute;
  bottom:30%;
  left:0;
  width:100%;
  height:16%;
  background: linear-gradient(to bottom, #cfe6e2 0%, #a8cdc8 50%, #8fb8b3 100%);
  overflow:hidden;
}
.ripple {
  position:absolute;
  width:140%;
  height:2px;
  left:-20%;
  background: linear-gradient(to right, transparent, rgba(255,255,255,0.55), transparent);
  filter: blur(0.5px);
  animation: rippleMove 6s ease-in-out infinite;
}
@keyframes rippleMove {
  0%,100% { opacity:0.25; transform: translateX(0); }
  50% { opacity:0.6; transform: translateX(3%); }
}

/* 小桥 */
.bridge {
  position:absolute;
  bottom:33%;
  left:38%;
  width:160px;
  height:46px;
}
.bridge-arch {
  position:absolute;
  bottom:0; left:0;
  width:160px; height:46px;
  border-radius: 160px 160px 0 0 / 46px 46px 0 0;
  border: 6px solid #5c4330;
  border-bottom: none;
  background: transparent;
}
.bridge-deck {
  position:absolute;
  bottom:18px; left:6px;
  width:148px; height:5px;
  background:#6b4f38;
  border-radius:3px;
}
.bridge-reflection {
  position:absolute;
  top:46px; left:0;
  width:160px; height:20px;
  border-radius: 0 0 160px 160px / 0 0 20px 20px;
  border: 4px solid rgba(92,67,48,0.25);
  border-top: none;
  filter: blur(1px);
}

/* 油菜花田 */
.field {
  position:absolute;
  bottom:0; left:0;
  width:100%; height:33%;
  overflow:hidden;
}
.crop-row {
  position:absolute;
  bottom:0;
  width:100%;
  display:flex;
  justify-content:space-around;
}
.stalk {
  position:relative;
  width:3px;
  background: linear-gradient(to top, #4a6b34, #6d8f4a 70%, #8fae5e);
  transform-origin: bottom center;
  animation: stalkSway 4.2s ease-in-out infinite;
}
@keyframes stalkSway {
  0%,100% { transform: rotate(-3deg); }
  50% { transform: rotate(3deg); }
}
.bloom {
  position:absolute;
  top:-6px; left:-5px;
  width:13px; height:9px;
  border-radius:50%;
  background: radial-gradient(circle at 35% 30%, #fff3b0, #f3cf3f 65%, #e0b62a 100%);
}

/* 蝴蝶 */
.butterfly {
  position:absolute;
  width:14px; height:10px;
  animation: flyPath 14s ease-in-out infinite;
}
.wing {
  position:absolute;
  width:7px; height:9px;
  background: linear-gradient(135deg, #fff9e6, #f6d94a);
  border-radius: 60% 40% 60% 40%;
  animation: flutter 0.32s ease-in-out infinite;
}
.wing.left { left:0; transform-origin: right center; }
.wing.right { right:0; transform-origin: left center; }
@keyframes flutter {
  0%,100% { transform: scaleX(1) rotate(0deg); }
  50% { transform: scaleX(0.55) rotate(8deg); }
}
@keyframes flyPath {
  0%   { transform: translate(0,0); }
  20%  { transform: translate(60px,-40px); }
  40%  { transform: translate(20px,-90px); }
  60%  { transform: translate(-50px,-50px); }
  80%  { transform: translate(-20px,-10px); }
  100% { transform: translate(0,0); }
}

/* 蜻蜓 */
.dragonfly {
  position:absolute;
  width:24px; height:3px;
  animation: dragonHover 9s ease-in-out infinite;
}
.dragonfly .body {
  position:absolute;
  left:8px; top:-1px;
  width:14px; height:2px;
  background: linear-gradient(to right, #4a7c7a, #6fa8a0);
  border-radius:2px;
}
.dragonfly .wing-d {
  position:absolute;
  width:9px; height:3px;
  background: rgba(170,220,215,0.55);
  border-radius:50%;
  animation: dragonWing 0.12s linear infinite;
}
.dragonfly .wing-d.w1 { top:-3px; left:6px; transform-origin: right center; }
.dragonfly .wing-d.w2 { top:-3px; left:14px; transform-origin: left center; }
@keyframes dragonWing {
  0%,100% { transform: scaleY(1); }
  50% { transform: scaleY(0.3); }
}
@keyframes dragonHover {
  0%   { transform: translate(0,0) rotate(0deg); }
  15%  { transform: translate(40px,-15px) rotate(8deg); }
  30%  { transform: translate(70px,5px) rotate(-4deg); }
  45%  { transform: translate(30px,25px) rotate(-10deg); }
  60%  { transform: translate(-20px,10px) rotate(6deg); }
  75%  { transform: translate(-45px,-10px) rotate(4deg); }
  100% { transform: translate(0,0) rotate(0deg); }
}

.title {
  position:absolute;
  top:6%; left:7%;
  color:#3f4a2e;
  font-size:22px;
  letter-spacing:8px;
  opacity:0;
  animation: fadeIn 2.5s ease forwards;
  animation-delay: 0.3s;
  text-shadow: 0 1px 6px rgba(255,255,255,0.4);
}
.title .sub {
  display:block;
  margin-top:6px;
  font-size:11px;
  letter-spacing:3px;
  color:#5c6b46;
}
.poem {
  position:absolute;
  bottom:8%;
  right:6%;
  text-align:right;
  color:#3f4a2e;
  text-shadow: 0 1px 8px rgba(255,255,255,0.5);
}
.poem .line {
  font-size:17px;
  letter-spacing:3px;
  line-height:1.9;
  opacity:0;
  animation: fadeIn 2s ease forwards;
}
.poem .line:nth-child(1){ animation-delay: 0.6s; }
.poem .line:nth-child(2){ animation-delay: 2.2s; }
.poem .source {
  margin-top:10px;
  font-size:12px;
  letter-spacing:2px;
  color:#6b7a55;
  opacity:0;
  animation: fadeIn 2s ease forwards;
  animation-delay: 3.6s;
}
@keyframes fadeIn { to { opacity:0.95; } }
</style>
</head>
<body>
<div id="stage">
  <div class="sun"></div>
  <div class="hills-far"></div>
  <div class="hills-near"></div>

  <div class="stream" id="stream"></div>

  <div class="bridge">
    <div class="bridge-reflection"></div>
    <div class="bridge-arch"></div>
    <div class="bridge-deck"></div>
  </div>

  <div class="field" id="field"></div>

  <div class="title">油菜花田<span class="sub">江汉平原 · 春日</span></div>
  <div class="poem">
    <div class="line">儿童急走追黄蝴蝶，</div>
    <div class="line">飞入菜花无处寻。</div>
    <div class="source">—— 杨万里《宿新市徐公店》</div>
  </div>
</div>

<script>
const stage = document.getElementById('stage');
const field = document.getElementById('field');
const stream = document.getElementById('stream');

for (let i=0;i<5;i++){
  const r=document.createElement('div');
  r.className='ripple';
  r.style.top=(15+i*16)+'%';
  r.style.animationDelay=(Math.random()*3)+'s';
  r.style.animationDuration=(5+Math.random()*2)+'s';
  stream.appendChild(r);
}

for (let row=0; row<4; row++){
  const rowDiv=document.createElement('div');
  rowDiv.className='crop-row';
  rowDiv.style.bottom=(row*8)+'%';
  const count = 34 - row*3;
  for (let i=0;i<count;i++){
    const stalk=document.createElement('div');
    stalk.className='stalk';
    const h = 26 + row*7 + Math.random()*10;
    stalk.style.height=h+'px';
    stalk.style.animationDelay=(Math.random()*4)+'s';
    stalk.style.animationDuration=(3.5+Math.random()*2)+'s';
    const bloom=document.createElement('div');
    bloom.className='bloom';
    stalk.appendChild(bloom);
    rowDiv.appendChild(stalk);
  }
  field.appendChild(rowDiv);
}

for (let i=0;i<5;i++){
  const b=document.createElement('div');
  b.className='butterfly';
  b.style.left=(15+Math.random()*70)+'%';
  b.style.top=(28+Math.random()*35)+'%';
  b.style.animationDelay=(Math.random()*8)+'s';
  b.style.animationDuration=(11+Math.random()*6)+'s';
  const wl=document.createElement('div'); wl.className='wing left';
  const wr=document.createElement('div'); wr.className='wing right';
  wl.style.animationDelay=(Math.random()*0.3)+'s';
  wr.style.animationDelay=(Math.random()*0.3)+'s';
  b.appendChild(wl); b.appendChild(wr);
  stage.appendChild(b);
}

for (let i=0;i<3;i++){
  const d=document.createElement('div');
  d.className='dragonfly';
  d.style.left=(20+Math.random()*60)+'%';
  d.style.top=(35+Math.random()*25)+'%';
  d.style.animationDelay=(Math.random()*5)+'s';
  d.style.animationDuration=(7+Math.random()*4)+'s';
  const body=document.createElement('div'); body.className='body';
  const w1=document.createElement('div'); w1.className='wing-d w1';
  const w2=document.createElement('div'); w2.className='wing-d w2';
  d.appendChild(body); d.appendChild(w1); d.appendChild(w2);
  stage.appendChild(d);
}
</script>
</body>
</html>
