<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>给茹茹的惊喜盒</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --plum: #2b1b3d;
    --plum-deep: #1c1130;
    --coral: #ff6f91;
    --yellow: #ffd166;
    --mint: #8fe3c7;
    --cream: #fdf6ec;
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0; padding:0; height:100%;
    background: radial-gradient(ellipse at top, var(--plum) 0%, var(--plum-deep) 70%);
    font-family:'Nunito', sans-serif;
    color:var(--cream);
    overflow-x:hidden;
  }
  .stars{
    position:fixed; inset:0; pointer-events:none; z-index:0;
  }
  .stars span{
    position:absolute; width:3px; height:3px; background:var(--cream);
    border-radius:50%; opacity:.5; animation:twinkle 3s ease-in-out infinite;
  }
  @keyframes twinkle{ 0%,100%{opacity:.15;} 50%{opacity:.8;} }

  .stage{
    position:relative; z-index:1;
    min-height:100vh; display:flex; flex-direction:column;
    align-items:center; justify-content:center;
    padding:6vh 6vw; text-align:center;
  }
  .eyebrow{
    font-size:.85rem; letter-spacing:.3em; text-transform:uppercase;
    color:var(--mint); font-weight:700; margin-bottom:.8rem;
  }
  h1{
    font-family:'Baloo 2', sans-serif;
    font-weight:800;
    font-size:clamp(2rem, 6vw, 3.2rem);
    margin:0 0 .3rem;
    color:var(--cream);
  }
  h1 span{ color:var(--coral); }
  .sub{
    font-size:1.05rem; opacity:.75; margin-bottom:3rem; max-width:32em;
  }

  .box-wrap{
    position:relative; width:220px; height:190px; cursor:pointer;
    user-select:none; -webkit-tap-highlight-color:transparent;
  }
  .box-wrap:focus-visible{ outline:3px solid var(--mint); outline-offset:6px; border-radius:12px; }

  .lid{
    position:absolute; top:0; left:-10px; right:-10px;
    height:60px; background:linear-gradient(135deg, var(--coral), #ff9bb0);
    border-radius:14px;
    box-shadow:0 8px 18px rgba(0,0,0,.25);
    transform-origin: bottom center;
    transition: transform .55s cubic-bezier(.34,1.56,.64,1), opacity .4s ease;
    z-index:3;
  }
  .lid::after{
    content:''; position:absolute; left:50%; top:100%;
    transform:translateX(-50%);
    width:36px; height:36px; background:var(--yellow);
    border-radius:50%;
  }
  .ribbon-v{
    position:absolute; left:50%; top:0; bottom:0; width:22px;
    transform:translateX(-50%); background:var(--yellow); z-index:2;
  }
  .body{
    position:absolute; bottom:0; left:0; right:0; height:130px;
    background:linear-gradient(160deg, #6a4a8f, #4a3270);
    border-radius:14px;
    box-shadow:0 12px 24px rgba(0,0,0,.35), inset 0 2px 0 rgba(255,255,255,.15);
    z-index:1;
  }
  .ribbon-h{
    position:absolute; bottom:0; left:0; right:0; height:130px;
    display:flex; align-items:center; justify-content:center;
  }
  .ribbon-h::before{
    content:''; position:absolute; top:0; bottom:0; left:50%;
    transform:translateX(-50%); width:22px; background:var(--yellow);
  }

  .box-wrap.open .lid{
    transform: translateY(-70px) rotate(-18deg);
    opacity:0;
  }

  .hint{
    margin-top:1.6rem; font-size:.9rem; opacity:.55;
    font-weight:600;
  }

  .reveal{
    margin-top:2.4rem; max-width:34em;
    min-height:1px;
  }
  .card{
    background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.12);
    backdrop-filter:blur(6px);
    border-radius:18px;
    padding:1.6rem 1.8rem;
    font-size:1.15rem; line-height:1.6;
    font-weight:600;
    opacity:0; transform:translateY(14px) scale(.97);
    animation:cardIn .5s ease forwards;
  }
  @keyframes cardIn{ to{ opacity:1; transform:translateY(0) scale(1); } }
  .card .tag{
    display:inline-block; font-family:'Baloo 2',sans-serif; font-size:.75rem;
    background:var(--mint); color:var(--plum-deep); font-weight:700;
    padding:.15rem .6rem; border-radius:999px; margin-bottom:.7rem;
    letter-spacing:.05em;
  }

  .again{
    margin-top:1.4rem; border:none; cursor:pointer;
    background:var(--coral); color:var(--cream);
    font-family:'Baloo 2',sans-serif; font-weight:700; font-size:1rem;
    padding:.7rem 1.6rem; border-radius:999px;
    box-shadow:0 6px 16px rgba(255,111,145,.35);
    transition:transform .15s ease, box-shadow .15s ease;
  }
  .again:hover{ transform:translateY(-2px); box-shadow:0 10px 20px rgba(255,111,145,.45); }
  .again:active{ transform:translateY(0); }
  .again:focus-visible{ outline:3px solid var(--mint); outline-offset:3px; }

  canvas.confetti{
    position:fixed; inset:0; z-index:5; pointer-events:none;
  }

  @media (prefers-reduced-motion: reduce){
    .lid, .card{ transition:none; animation:none; }
    .box-wrap.open .lid{ opacity:0; transform:translateY(-70px); }
  }
</style>
</head>
<body>

<div class="stars" id="stars"></div>
<canvas class="confetti" id="confetti"></canvas>

<div class="stage">
  <div class="eyebrow">专属惊喜 · 献给茹茹</div>
  <h1>拆一个 <span>小惊喜</span> 吧</h1>
  <p class="sub">不管今天顺不顺心,这里有个盒子一直等着你。点开它,看看今天会开出点什么~</p>

  <div class="box-wrap" id="box" role="button" tabindex="0" aria-label="点击打开惊喜盒">
    <div class="lid"></div>
    <div class="ribbon-v"></div>
    <div class="body"></div>
    <div class="ribbon-h"></div>
  </div>
  <div class="hint" id="hint">点一下盒子,拆开看看</div>

  <div class="reveal" id="reveal"></div>
</div>

<script>
const messages = [
  {tag:"夸夸", text:"今天的茹茹依然是最有魅力的那一个,连生气的样子都很可爱。"},
  {tag:"小任务", text:"接下来十分钟,请对自己好一点:喝口水,伸个懒腰,深呼吸三次。"},
  {tag:"暖心话", text:"不开心是可以的,但记得——不开心的情绪会过去,喜欢你的人不会。"},
  {tag:"冷知识", text:"章鱼有三颗心脏,其中两颗只负责给腮供血。跟你分享一下,别问为什么。"},
  {tag:"惊喜", text:"如果现在有个愿望额度,悄悄许一个吧,说不定今天就实现了。"},
  {tag:"夸夸", text:"你解决问题的样子,比大多数人想象中都要靠谱。"},
  {tag:"小任务", text:"给一个让你开心的人发条消息,哪怕只是一个表情包。"},
  {tag:"暖心话", text:"哼一声也没关系,允许自己有情绪,是一种很酷的能力。"}
];

// 音效(用 Web Audio 合成,不需要外部文件)
let audioCtx = null;
function getAudioCtx(){
  if(!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
  if(audioCtx.state === 'suspended') audioCtx.resume();
  return audioCtx;
}
function playTone(freq, start, duration, type='sine', peakGain=0.18){
  const ctx = getAudioCtx();
  const osc = ctx.createOscillator();
  const gain = ctx.createGain();
  osc.type = type;
  osc.frequency.setValueAtTime(freq, ctx.currentTime + start);
  gain.gain.setValueAtTime(0, ctx.currentTime + start);
  gain.gain.linearRampToValueAtTime(peakGain, ctx.currentTime + start + 0.02);
  gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + start + duration);
  osc.connect(gain);
  gain.connect(ctx.destination);
  osc.start(ctx.currentTime + start);
  osc.stop(ctx.currentTime + start + duration + 0.05);
}
function playOpenSound(){
  // 开盒子:上扬的"噗~叮"
  playTone(392, 0, 0.12, 'triangle', 0.15);
  playTone(523.25, 0.08, 0.16, 'triangle', 0.16);
  playTone(783.99, 0.18, 0.35, 'sine', 0.18);
}
function playChime(){
  // 拆开惊喜:清脆小三音
  playTone(659.25, 0, 0.18, 'sine', 0.14);
  playTone(830.61, 0.09, 0.2, 'sine', 0.13);
  playTone(987.77, 0.18, 0.3, 'sine', 0.12);
}

let usedIndices = [];
function pickMessage(){
  if(usedIndices.length >= messages.length) usedIndices = [];
  let idx;
  do{ idx = Math.floor(Math.random()*messages.length); } while(usedIndices.includes(idx));
  usedIndices.push(idx);
  return messages[idx];
}

const box = document.getElementById('box');
const hint = document.getElementById('hint');
const reveal = document.getElementById('reveal');
let opened = false;

function showMessage(){
  const m = pickMessage();
  reveal.innerHTML = `
    <div class="card">
      <span class="tag">${m.tag}</span>
      <div>${m.text}</div>
      <button class="again" id="again">再拆一个</button>
    </div>
  `;
  document.getElementById('again').addEventListener('click', ()=>{
    playChime();
    burstConfetti();
    reveal.innerHTML = '';
    requestAnimationFrame(showMessage);
  });
}

function openBox(){
  if(opened) return;
  opened = true;
  box.classList.add('open');
  hint.textContent = '';
  playOpenSound();
  burstConfetti();
  setTimeout(showMessage, 260);
}

box.addEventListener('click', openBox);
box.addEventListener('keydown', (e)=>{
  if(e.key === 'Enter' || e.key === ' '){ e.preventDefault(); openBox(); }
});

// starfield background
const starsEl = document.getElementById('stars');
for(let i=0;i<40;i++){
  const s = document.createElement('span');
  s.style.left = Math.random()*100+'%';
  s.style.top = Math.random()*100+'%';
  s.style.animationDelay = (Math.random()*3)+'s';
  starsEl.appendChild(s);
}

// confetti
const canvas = document.getElementById('confetti');
const ctx = canvas.getContext('2d');
function resize(){ canvas.width = innerWidth; canvas.height = innerHeight; }
resize();
window.addEventListener('resize', resize);

const colors = ['#ff6f91','#ffd166','#8fe3c7','#fdf6ec'];
let particles = [];
function burstConfetti(){
  const cx = box.getBoundingClientRect().left + box.offsetWidth/2;
  const cy = box.getBoundingClientRect().top + 40;
  for(let i=0;i<70;i++){
    particles.push({
      x: cx, y: cy,
      vx: (Math.random()-0.5)*8,
      vy: Math.random()*-9 - 2,
      size: Math.random()*6+4,
      color: colors[Math.floor(Math.random()*colors.length)],
      rot: Math.random()*360,
      vrot: (Math.random()-0.5)*12,
      life: 100
    });
  }
}
function tick(){
  ctx.clearRect(0,0,canvas.width,canvas.height);
  particles.forEach(p=>{
    p.vy += 0.28;
    p.x += p.vx;
    p.y += p.vy;
    p.rot += p.vrot;
    p.life -= 1;
    ctx.save();
    ctx.translate(p.x,p.y);
    ctx.rotate(p.rot*Math.PI/180);
    ctx.fillStyle = p.color;
    ctx.globalAlpha = Math.max(p.life/100, 0);
    ctx.fillRect(-p.size/2,-p.size/2,p.size,p.size*0.6);
    ctx.restore();
  });
  particles = particles.filter(p=>p.life>0 && p.y < canvas.height+50);
  requestAnimationFrame(tick);
}
tick();
</script>

</body>
</html>
