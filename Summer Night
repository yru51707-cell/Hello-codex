<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>夏夜 · 江汉平原</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  html,body {
    width:100%; height:100%;
    overflow:hidden;
    background: linear-gradient(to bottom, #0b1320 0%, #122035 30%, #1c3148 55%, #2a4a4f 75%, #1a3030 100%);
    font-family: "Songti SC", "STSong", "SimSun", serif;
  }
  #stage {
    position:relative;
    width:100vw; height:100vh;
  }

  .star {
    position:absolute;
    background:#fff;
    border-radius:50%;
    opacity:0.8;
    animation: twinkle 3s infinite ease-in-out;
  }
  @keyframes twinkle {
    0%,100% { opacity:0.3; }
    50% { opacity:1; }
  }

  .moon {
    position:absolute;
    top:6%; right:12%;
    width:70px; height:70px;
    border-radius:50%;
    background: radial-gradient(circle at 35% 35%, #fdf6e3, #f3e7c4 60%, #e8d9a8 100%);
    box-shadow: 0 0 40px 18px rgba(253,246,227,0.25), 0 0 80px 40px rgba(253,246,227,0.08);
  }

  .hills {
    position:absolute;
    bottom:38%;
    width:100%;
    height:14%;
    background:#0f1c22;
    clip-path: polygon(0% 100%, 0% 60%, 10% 40%, 22% 55%, 35% 30%, 50% 50%, 65% 25%, 80% 48%, 92% 35%, 100% 55%, 100% 100%);
    opacity:0.85;
  }

  .field {
    position:absolute;
    bottom:0; left:0;
    width:100%; height:42%;
    background: linear-gradient(to bottom, #1a2e26 0%, #16241d 50%, #0e1712 100%);
    overflow:hidden;
  }
  .rice-row {
    position:absolute;
    bottom:0;
    width:100%;
    display:flex;
    justify-content:space-around;
  }
  .rice {
    width:2px;
    background: linear-gradient(to top, #2e4a36, #4a6b4a 60%, #6b8a5e);
    border-radius: 2px 2px 0 0;
    transform-origin: bottom center;
    animation: sway 4s ease-in-out infinite;
  }
  @keyframes sway {
    0%,100% { transform: rotate(-4deg); }
    50% { transform: rotate(4deg); }
  }

  .water-glint {
    position:absolute;
    bottom:2%;
    left:20%;
    width:60%;
    height:3px;
    background: linear-gradient(to right, transparent, rgba(253,246,227,0.5), transparent);
    filter: blur(1px);
    animation: glint 5s ease-in-out infinite;
  }
  @keyframes glint {
    0%,100% { opacity:0.2; }
    50% { opacity:0.6; }
  }

  .firefly {
    position:absolute;
    width:5px; height:5px;
    background: #f6e7a1;
    border-radius:50%;
    box-shadow: 0 0 8px 3px rgba(246,231,161,0.9), 0 0 16px 6px rgba(246,231,161,0.4);
    animation: drift 12s linear infinite, blink 2.6s ease-in-out infinite;
  }
  @keyframes blink {
    0%,100% { opacity:0.1; }
    50% { opacity:1; }
  }
  @keyframes drift {
    0%   { transform: translate(0,0); }
    25%  { transform: translate(40px,-30px); }
    50%  { transform: translate(10px,-60px); }
    75%  { transform: translate(-30px,-20px); }
    100% { transform: translate(0,0); }
  }

  .house {
    position:absolute;
    bottom:34%;
    left:8%;
    width:90px;
    height:60px;
  }
  .roof {
    position:absolute;
    top:0; left:-10px;
    width:110px; height:0;
    border-left: 55px solid transparent;
    border-right: 55px solid transparent;
    border-bottom: 38px solid #0a1410;
  }
  .body {
    position:absolute;
    top:36px; left:10px;
    width:70px; height:30px;
    background:#0a1410;
  }
  .window {
    position:absolute;
    top:44px; left:32px;
    width:10px; height:10px;
    background: #e8b923;
    opacity:0.85;
    box-shadow: 0 0 10px 4px rgba(232,185,35,0.4);
    animation: lamp 6s ease-in-out infinite;
  }
  @keyframes lamp {
    0%,100% { opacity:0.6; }
    50% { opacity:0.95; }
  }

  .poem {
    position:absolute;
    bottom:10%;
    right:6%;
    text-align:right;
    color:#e8e2c8;
    text-shadow: 0 0 12px rgba(0,0,0,0.6);
  }
  .poem .line {
    font-size:17px;
    letter-spacing:3px;
    line-height:1.9;
    opacity:0;
    animation: fadeIn 2s ease forwards;
  }
  .poem .line:nth-child(1){ animation-delay: 0.6s; }
  .poem .line:nth-child(2){ animation-delay: 2.2s; }
  .poem .source {
    margin-top:10px;
    font-size:12px;
    letter-spacing:2px;
    color:#9aa68f;
    opacity:0;
    animation: fadeIn 2s ease forwards;
    animation-delay: 3.6s;
  }
  @keyframes fadeIn {
    to { opacity:0.95; }
  }

  .title {
    position:absolute;
    top:6%; left:7%;
    color:#e8e2c8;
    font-size:22px;
    letter-spacing:8px;
    opacity:0;
    animation: fadeIn 2.5s ease forwards;
    animation-delay: 0.3s;
    text-shadow: 0 0 12px rgba(0,0,0,0.5);
  }
  .title .sub {
    display:block;
    margin-top:6px;
    font-size:11px;
    letter-spacing:3px;
    color:#8d9686;
  }
</style>
</head>
<body>
<div id="stage">
  <div class="moon"></div>
  <div class="hills"></div>
  <div class="house">
    <div class="roof"></div>
    <div class="body"></div>
    <div class="window"></div>
  </div>
  <div class="field" id="field">
    <div class="water-glint"></div>
  </div>

  <div class="title">夏夜<span class="sub">江汉平原 · 稻田</span></div>

  <div class="poem">
    <div class="line">稻花香里说丰年，</div>
    <div class="line">听取蛙声一片。</div>
    <div class="source">—— 辛弃疾《西江月》</div>
  </div>
</div>

<script>
  const stage = document.getElementById('stage');
  const field = document.getElementById('field');

  for (let i=0;i<70;i++){
    const s=document.createElement('div');
    s.className='star';
    const size=Math.random()*2+1;
    s.style.width=size+'px';
    s.style.height=size+'px';
    s.style.left=Math.random()*100+'%';
    s.style.top=Math.random()*45+'%';
    s.style.animationDelay=(Math.random()*3)+'s';
    stage.appendChild(s);
  }

  for (let row=0; row<5; row++){
    const rowDiv=document.createElement('div');
    rowDiv.className='rice-row';
    rowDiv.style.bottom=(row*9)+'%';
    const count = 40 - row*3;
    for (let i=0;i<count;i++){
      const r=document.createElement('div');
      r.className='rice';
      const h = 20 + row*6 + Math.random()*8;
      r.style.height=h+'px';
      r.style.animationDelay=(Math.random()*4)+'s';
      r.style.animationDuration=(3+Math.random()*2)+'s';
      r.style.opacity = 0.5 + row*0.1;
      rowDiv.appendChild(r);
    }
    field.appendChild(rowDiv);
  }

  for (let i=0;i<22;i++){
    const f=document.createElement('div');
    f.className='firefly';
    f.style.left=(10+Math.random()*80)+'%';
    f.style.top=(45+Math.random()*40)+'%';
    f.style.animationDelay=(Math.random()*6)+'s, '+(Math.random()*2.6)+'s';
    f.style.animationDuration=(9+Math.random()*8)+'s, '+(2+Math.random()*1.5)+'s';
    stage.appendChild(f);
  }
</script>
</body>
</html>
