<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>雪梅记 · 岁寒三友</title>
<style>
  :root{
    --sky-top:#0a0f2e;
    --sky-mid:#1c1f52;
    --sky-low:#33356e;
    --moon:#e8e6ff;
    --moon-glow:rgba(200,195,255,0.35);
    --mtn-far:#211f4d;
    --mtn-near:#171638;
    --snowcol:#f2f3ff;
    --plum:#a86bc9;
    --plum-deep:#7c3fa0;
    --plum-core:#f0d98c;
    --bamboo:#3d6e82;
    --bamboo-dark:#274d5c;
    --pine:#274a45;
    --pine-dark:#16302c;
    --ink:#e9e6ff;
    --ink-soft:#b9b6e6;
    --panel-bg:rgba(14,14,40,0.62);
    --card-border:rgba(180,150,220,0.35);
  }
  *{box-sizing:border-box;}
  html,body{
    margin:0;padding:0;height:100%;overflow:hidden;
    background:var(--sky-top);
    font-family:-apple-system,"PingFang SC","Microsoft YaHei",sans-serif;
    color:var(--ink);
  }
  .stage{
    position:relative;
    width:100vw;height:100vh;
    background:linear-gradient(180deg,var(--sky-top) 0%, var(--sky-mid) 45%, var(--sky-low) 75%, #46437f 100%);
    overflow:hidden;
  }
  #stars{position:absolute;inset:0;width:100%;height:100%;}
  .star{
    position:absolute;border-radius:50%;background:#eae7ff;
    animation:twinkle 4s ease-in-out infinite;
  }
  @keyframes twinkle{
    0%,100%{opacity:.25;}
    50%{opacity:.9;}
  }
  .moon{
    position:absolute;
    top:8%;right:12%;
    width:min(9vw,90px);height:min(9vw,90px);
    border-radius:50%;
    background:radial-gradient(circle at 35% 35%, #fbfaff, var(--moon) 60%, #cfc9f0 100%);
    box-shadow:0 0 60px 25px var(--moon-glow), 0 0 120px 60px rgba(160,150,255,0.15);
  }
  svg{position:absolute;left:0;bottom:0;width:100%;height:auto;display:block;pointer-events:none;}
  svg .hotspot{pointer-events:auto;}
  .layer-far{opacity:.85;}
  .sway-pine{transform-origin:50% 100%;animation:sway-pine 6s ease-in-out infinite;}
  @keyframes sway-pine{
    0%,100%{transform:rotate(0deg);}
    50%{transform:rotate(0.6deg);}
  }
  .bamboo-stalk{transform-origin:50% 100%;animation:sway-bamboo 4.5s ease-in-out infinite;}
  .bamboo-stalk:nth-child(2){animation-delay:.3s;}
  .bamboo-stalk:nth-child(3){animation-delay:.6s;}
  .bamboo-stalk:nth-child(4){animation-delay:.9s;}
  @keyframes sway-bamboo{
    0%,100%{transform:rotate(-1.4deg);}
    50%{transform:rotate(1.8deg);}
  }
  .plum-branch{transform-origin:20% 100%;animation:sway-plum 7s ease-in-out infinite;}
  @keyframes sway-plum{
    0%,100%{transform:rotate(-0.4deg);}
    50%{transform:rotate(0.8deg);}
  }
  .blossom{animation:bloom-pulse 3.5s ease-in-out infinite;transform-origin:center;}
  @keyframes bloom-pulse{
    0%,100%{transform:scale(1);opacity:.95;}
    50%{transform:scale(1.12);opacity:1;}
  }
  .hotspot{cursor:pointer;}
  .hotspot:hover rect, .hotspot:hover circle.hz{opacity:0.06;}
  .hz{fill:#fff;opacity:0;transition:opacity .25s;}

  canvas#snowcanvas{position:absolute;inset:0;width:100%;height:100%;pointer-events:none;}

  .petal{
    position:absolute;
    width:9px;height:9px;
    background:radial-gradient(circle at 35% 30%, #d9a9ee, var(--plum) 70%, var(--plum-deep));
    border-radius:60% 10% 60% 10%;
    pointer-events:none;
    opacity:.9;
  }

  header{
    position:absolute;top:0;left:0;right:0;
    text-align:center;
    padding:clamp(20px,4vh,40px) 20px 0;
    pointer-events:none;
    z-index:5;
  }
  header h1{
    font-family:'Songti SC','STSong','SimSun',serif;
    font-weight:900;
    font-size:clamp(28px,4.2vw,46px);
    letter-spacing:.12em;
    margin:0;
    background:linear-gradient(180deg,#fbf9ff,#c9b8ec 65%, #9b7fd6);
    -webkit-background-clip:text;
    background-clip:text;
    color:transparent;
    text-shadow:0 0 30px rgba(160,120,220,0.25);
  }
  header p{
    font-family:'Songti SC','STSong','SimSun',serif;
    font-weight:400;
    font-size:clamp(12px,1.4vw,16px);
    letter-spacing:.3em;
    color:var(--ink-soft);
    margin:10px 0 0;
  }

  .hint{
    position:absolute;
    bottom:14px;left:50%;
    transform:translateX(-50%);
    font-size:12px;
    color:var(--ink-soft);
    letter-spacing:.08em;
    z-index:5;
    opacity:.75;
    pointer-events:none;
  }

  .card{
    position:absolute;
    left:50%;
    bottom:9%;
    transform:translate(-50%,20px);
    width:min(560px,86vw);
    background:var(--panel-bg);
    border:1px solid var(--card-border);
    -webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);
    border-radius:16px;
    padding:20px 26px;
    z-index:6;
    opacity:0;
    transition:opacity .5s ease, transform .5s ease;
    box-shadow:0 20px 60px rgba(0,0,0,0.4);
  }
  .card.show{opacity:1;transform:translate(-50%,0);}
  .card .who{
    font-family:'Songti SC','STSong','SimSun',serif;
    font-size:13px;
    letter-spacing:.2em;
    margin-bottom:8px;
    display:inline-block;
    padding:3px 12px;
    border-radius:20px;
  }
  .who.snow{color:#dfe6ff;background:rgba(150,170,255,0.18);}
  .who.plum{color:#f0d3ff;background:rgba(180,110,220,0.2);}
  .who.bamboo{color:#cdeee6;background:rgba(80,160,150,0.2);}
  .who.pine{color:#c9e4d6;background:rgba(50,120,95,0.25);}
  .card p{
    font-family:'Songti SC','STSong','SimSun',serif;
    font-size:clamp(15px,2vw,18px);
    line-height:1.85;
    margin:0;
    color:#f4f1ff;
  }
  .card .idx{
    margin-top:10px;
    font-size:11px;
    color:var(--ink-soft);
    letter-spacing:.15em;
    text-align:right;
  }

  @media (max-width:640px){
    .moon{width:60px;height:60px;top:6%;right:8%;}
    header{padding-top:22px;}
  }

  @media (prefers-reduced-motion: reduce){
    .sway-pine,.bamboo-stalk,.plum-branch,.blossom,.star{animation:none !important;}
  }
</style>
</head>
<body>
<div class="stage" id="stage">
  <div id="stars"></div>
  <div class="moon"></div>
  <canvas id="snowcanvas"></canvas>

  <!-- 远山 -->
  <svg class="layer-far" viewBox="0 0 1600 900" preserveAspectRatio="none" style="height:62%;">
    <polygon points="0,420 200,300 420,380 650,260 900,360 1150,270 1350,350 1600,300 1600,900 0,900" fill="#211f4d"/>
  </svg>
  <!-- 近山 -->
  <svg viewBox="0 0 1600 900" preserveAspectRatio="none" style="height:48%;">
    <polygon points="0,480 250,380 500,460 780,340 1050,440 1300,360 1600,420 1600,900 0,900" fill="#171638"/>
  </svg>

  <!-- 松树 左侧 -->
  <svg viewBox="0 0 1600 900" preserveAspectRatio="none" style="height:100%;">
    <g class="hotspot" id="pine-hotspot">
      <g class="sway-pine" transform="translate(190,560)">
        <rect x="-10" y="120" width="20" height="140" fill="#2b1f1a"/>
        <polygon points="0,-40 -95,80 95,80" fill="var(--pine-dark)"/>
        <polygon points="0,10 -80,110 80,110" fill="var(--pine)"/>
        <polygon points="0,60 -100,160 100,160" fill="var(--pine-dark)"/>
        <polygon points="0,-40 -70,30 70,30" fill="var(--snowcol)" opacity="0.85"/>
        <polygon points="0,10 -55,60 55,60" fill="var(--snowcol)" opacity="0.7"/>
        <polygon points="0,60 -65,105 65,105" fill="var(--snowcol)" opacity="0.6"/>
      </g>
      <rect class="hz" x="60" y="440" width="270" height="360"/>
    </g>
  </svg>

  <!-- 竹子 右侧 -->
  <svg viewBox="0 0 1600 900" preserveAspectRatio="none" style="height:100%;">
    <g class="hotspot" id="bamboo-hotspot">
      <g transform="translate(1330,470)">
        <g class="bamboo-stalk">
          <rect x="-6" y="0" width="12" height="330" rx="6" fill="var(--bamboo)"/>
          <rect x="-7" y="70" width="14" height="5" fill="var(--bamboo-dark)"/>
          <rect x="-7" y="150" width="14" height="5" fill="var(--bamboo-dark)"/>
          <rect x="-7" y="230" width="14" height="5" fill="var(--bamboo-dark)"/>
          <path d="M0,40 Q40,10 70,-20" stroke="var(--bamboo)" stroke-width="5" fill="none" stroke-linecap="round"/>
          <path d="M0,90 Q-45,60 -75,25" stroke="var(--bamboo)" stroke-width="5" fill="none" stroke-linecap="round"/>
        </g>
        <g class="bamboo-stalk" transform="translate(48,20)">
          <rect x="-5" y="0" width="10" height="300" rx="5" fill="var(--bamboo-dark)"/>
          <rect x="-6" y="60" width="12" height="4" fill="#183a44"/>
          <rect x="-6" y="140" width="12" height="4" fill="#183a44"/>
          <path d="M0,30 Q35,5 58,-25" stroke="var(--bamboo-dark)" stroke-width="4" fill="none" stroke-linecap="round"/>
        </g>
        <g class="bamboo-stalk" transform="translate(-42,45)">
          <rect x="-5" y="0" width="10" height="280" rx="5" fill="var(--bamboo)"/>
          <rect x="-6" y="55" width="12" height="4" fill="var(--bamboo-dark)"/>
          <rect x="-6" y="130" width="12" height="4" fill="var(--bamboo-dark)"/>
          <path d="M0,25 Q-30,0 -55,-22" stroke="var(--bamboo)" stroke-width="4" fill="none" stroke-linecap="round"/>
        </g>
        <g class="bamboo-stalk" transform="translate(12,80)">
          <rect x="-4" y="0" width="8" height="240" rx="4" fill="var(--bamboo-dark)"/>
          <path d="M0,20 Q28,0 46,-18" stroke="var(--bamboo-dark)" stroke-width="3" fill="none" stroke-linecap="round"/>
        </g>
      </g>
      <rect class="hz" x="1210" y="470" width="220" height="330"/>
    </g>
  </svg>

  <!-- 梅树 中央偏前 -->
  <svg viewBox="0 0 1600 900" preserveAspectRatio="none" style="height:100%;">
    <g class="hotspot" id="plum-hotspot">
      <g transform="translate(770,900)">
        <path d="M0,0 C-6,-90 10,-160 -14,-230 C-30,-280 6,-330 -8,-390" stroke="#3a2436" stroke-width="16" fill="none" stroke-linecap="round"/>
        <g class="plum-branch">
          <path d="M-8,-390 C-40,-420 -90,-430 -150,-460" stroke="#3a2436" stroke-width="7" fill="none" stroke-linecap="round"/>
          <path d="M-60,-430 C-80,-450 -100,-448 -125,-465" stroke="#3a2436" stroke-width="4" fill="none" stroke-linecap="round"/>
          <g class="blossom"><circle cx="-150" cy="-460" r="7" fill="var(--plum)"/><circle cx="-150" cy="-460" r="2.4" fill="var(--plum-core)"/></g>
          <g class="blossom" style="animation-delay:.4s"><circle cx="-125" cy="-465" r="6" fill="var(--plum-deep)"/><circle cx="-125" cy="-465" r="2" fill="var(--plum-core)"/></g>
          <g class="blossom" style="animation-delay:.8s"><circle cx="-100" cy="-440" r="6.5" fill="var(--plum)"/><circle cx="-100" cy="-440" r="2.2" fill="var(--plum-core)"/></g>
        </g>
        <g class="plum-branch" style="animation-delay:.5s">
          <path d="M-8,-390 C30,-410 70,-400 120,-430" stroke="#3a2436" stroke-width="7" fill="none" stroke-linecap="round"/>
          <path d="M40,-408 C60,-425 80,-418 100,-435" stroke="#3a2436" stroke-width="4" fill="none" stroke-linecap="round"/>
          <g class="blossom" style="animation-delay:.2s"><circle cx="120" cy="-430" r="7" fill="var(--plum)"/><circle cx="120" cy="-430" r="2.4" fill="var(--plum-core)"/></g>
          <g class="blossom" style="animation-delay:.6s"><circle cx="100" cy="-435" r="6" fill="var(--plum-deep)"/><circle cx="100" cy="-435" r="2" fill="var(--plum-core)"/></g>
          <g class="blossom" style="animation-delay:1s"><circle cx="70" cy="-405" r="6.5" fill="var(--plum)"/><circle cx="70" cy="-405" r="2.2" fill="var(--plum-core)"/></g>
        </g>
        <g class="plum-branch" style="animation-delay:.2s">
          <path d="M-14,-230 C-50,-260 -70,-290 -110,-310" stroke="#3a2436" stroke-width="6" fill="none" stroke-linecap="round"/>
          <g class="blossom" style="animation-delay:.3s"><circle cx="-110" cy="-310" r="6" fill="var(--plum)"/><circle cx="-110" cy="-310" r="2" fill="var(--plum-core)"/></g>
          <g class="blossom" style="animation-delay:.9s"><circle cx="-70" cy="-290" r="5.5" fill="var(--plum-deep)"/><circle cx="-70" cy="-290" r="1.8" fill="var(--plum-core)"/></g>
        </g>
        <g class="plum-branch" style="animation-delay:.7s">
          <path d="M-14,-230 C30,-255 55,-275 95,-290" stroke="#3a2436" stroke-width="6" fill="none" stroke-linecap="round"/>
          <g class="blossom" style="animation-delay:.5s"><circle cx="95" cy="-290" r="6" fill="var(--plum)"/><circle cx="95" cy="-290" r="2" fill="var(--plum-core)"/></g>
          <g class="blossom" style="animation-delay:1.1s"><circle cx="55" cy="-275" r="5.5" fill="var(--plum-deep)"/><circle cx="55" cy="-275" r="1.8" fill="var(--plum-core)"/></g>
        </g>
        <ellipse cx="0" cy="-2" rx="34" ry="9" fill="var(--snowcol)" opacity="0.5"/>
      </g>
      <rect class="hz" x="600" y="380" width="360" height="520"/>
    </g>
  </svg>

  <!-- 地面雪 -->
  <svg viewBox="0 0 1600 900" preserveAspectRatio="none" style="height:14%;">
    <path d="M0,60 C200,10 400,90 650,40 C900,-10 1150,70 1600,20 L1600,900 L0,900 Z" fill="var(--snowcol)" opacity="0.92"/>
  </svg>

  <header>
    <h1>雪 梅 记</h1>
    <p>一夜寒香浮瘦影 · 满枝清雪伴红妆</p>
  </header>

  <div class="hint">点击梅树 · 竹子 · 松树,听听它们怎么说</div>

  <div class="card" id="card">
    <span class="who" id="who">雪</span>
    <p id="line">我落满你的肩,只为陪你,撑过这个寒冬。</p>
    <div class="idx" id="idx">1 / 4</div>
  </div>
</div>

<script>
// 星星
const starsWrap = document.getElementById('stars');
for(let i=0;i<90;i++){
  const s = document.createElement('div');
  s.className='star';
  const size = Math.random()*2+0.6;
  s.style.width=size+'px';
  s.style.height=size+'px';
  s.style.left=(Math.random()*100)+'%';
  s.style.top=(Math.random()*55)+'%';
  s.style.animationDelay=(Math.random()*4)+'s';
  starsWrap.appendChild(s);
}

// 雪花 canvas
const canvas = document.getElementById('snowcanvas');
const ctx = canvas.getContext('2d');
let W,H;
function resize(){
  W = canvas.width = window.innerWidth;
  H = canvas.height = window.innerHeight;
}
resize();
window.addEventListener('resize', resize);

const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const flakeCount = reduceMotion ? 0 : 110;
const flakes = Array.from({length:flakeCount}, ()=>({
  x: Math.random()*W,
  y: Math.random()*H,
  r: Math.random()*2.6+0.8,
  speed: Math.random()*0.9+0.35,
  drift: Math.random()*0.6-0.3,
  phase: Math.random()*Math.PI*2
}));

function drawSnow(){
  ctx.clearRect(0,0,W,H);
  ctx.fillStyle='rgba(245,246,255,0.9)';
  flakes.forEach(f=>{
    f.y += f.speed;
    f.x += Math.sin(f.phase)*0.3 + f.drift*0.2;
    f.phase += 0.01;
    if(f.y > H+5){ f.y=-5; f.x=Math.random()*W; }
    if(f.x > W+5) f.x=-5;
    if(f.x < -5) f.x=W+5;
    ctx.beginPath();
    ctx.arc(f.x,f.y,f.r,0,Math.PI*2);
    ctx.fill();
  });
  requestAnimationFrame(drawSnow);
}
drawSnow();

// 梅花花瓣飘落
const stage = document.getElementById('stage');
function spawnPetal(){
  if(reduceMotion) return;
  const petal = document.createElement('div');
  petal.className='petal';
  const startX = W*0.42 + (Math.random()*220-110);
  petal.style.left = startX+'px';
  petal.style.top = (H*0.12)+'px';
  const duration = 6+Math.random()*4;
  const drift = (Math.random()*160-80);
  petal.style.transition = `transform ${duration}s ease-in, opacity ${duration}s ease-in`;
  stage.appendChild(petal);
  requestAnimationFrame(()=>{
    petal.style.transform = `translate(${drift}px, ${H*0.75}px) rotate(${Math.random()*360}deg)`;
    petal.style.opacity = '0';
  });
  setTimeout(()=>petal.remove(), duration*1000+200);
}
setInterval(spawnPetal, 700);

// 对话内容
const dialogues = {
  snow_plum: [
    {who:'雪', cls:'snow', text:'我落满你的肩,只为陪你,撑过这个寒冬。'},
    {who:'梅', cls:'plum', text:'你怕见太阳,却愿为我多留一刻,这份心意我记下了。'},
    {who:'雪', cls:'snow', text:'你开得越冷越艳,是我见过最倔强的一抹红。'},
    {who:'梅', cls:'plum', text:'等你化了,我把你悄悄喝进根里——这样,你就没真正离开过我。'}
  ],
  bamboo: [
    {who:'竹', cls:'bamboo', text:'我未曾出土先有节,可惜没人写情书给我。'},
    {who:'竹', cls:'bamboo', text:'哗啦——风一吹,这声音比谈恋爱实在多了。'},
    {who:'竹', cls:'bamboo', text:'岁寒三友,松梅上镜,我负责鼓掌。'}
  ],
  pine: [
    {who:'松', cls:'pine', text:'大雪压青松,青松挺且直——就是有点冷清。'},
    {who:'松', cls:'pine', text:'我这四季常青,唯独缺个观众。'},
    {who:'松', cls:'pine', text:'你们聊你们的,我负责稳住这片天。'}
  ]
};
let idxState = {snow_plum:0, bamboo:0, pine:0};

const card = document.getElementById('card');
const whoEl = document.getElementById('who');
const lineEl = document.getElementById('line');
const idxEl = document.getElementById('idx');

function showLine(group){
  const arr = dialogues[group];
  const i = idxState[group] % arr.length;
  const item = arr[i];
  idxState[group]++;
  card.classList.remove('show');
  setTimeout(()=>{
    whoEl.textContent = item.who;
    whoEl.className = 'who '+item.cls;
    lineEl.textContent = item.text;
    idxEl.textContent = (i+1)+' / '+arr.length;
    card.classList.add('show');
  }, 180);
}

document.getElementById('plum-hotspot').addEventListener('click', ()=>showLine('snow_plum'));
document.getElementById('bamboo-hotspot').addEventListener('click', ()=>showLine('bamboo'));
document.getElementById('pine-hotspot').addEventListener('click', ()=>showLine('pine'));

// 初始展示一次
setTimeout(()=>showLine('snow_plum'), 1200);
</script>
</body>
</html>
